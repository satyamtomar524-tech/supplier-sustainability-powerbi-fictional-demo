model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Labels","Evidence","Occurrences","Data Quality"]

annotation PBI_ProTooling = ["DevMode"]

ref table Labels
ref table Evidence
ref table Occurrences
ref table 'Data Quality'

ref cultureInfo en-GB

