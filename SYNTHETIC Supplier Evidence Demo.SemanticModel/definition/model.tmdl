model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Labels","Evidence","Occurrences","Data Quality","RefreshInfo"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table Labels
ref table Evidence
ref table Occurrences
ref table 'Data Quality'
ref table RefreshInfo

ref cultureInfo en-GB

