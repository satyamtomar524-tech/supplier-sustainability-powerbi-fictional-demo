table Labels
	lineageTag: b815a6bd-cf74-49ef-a311-ca890628b4f9

	measure 'Candidate Labels' = COUNTROWS(Labels)
		formatString: 0
		lineageTag: c8b15292-7719-4b4a-bb1b-6e37f989edf5

	measure 'Reviewed Labels' = CALCULATE([Candidate Labels], KEEPFILTERS(Labels[Review status] = "Reviewed"))
		formatString: 0
		lineageTag: 85d4fa3d-3e65-4da4-8047-c7e6515ab31f

	measure 'Classified Labels' = CALCULATE([Candidate Labels], KEEPFILTERS(Labels[Classification status] = "Classified"))
		formatString: 0
		lineageTag: ac705229-1bf3-4fb7-b973-4527caa8379d

	measure 'Not Reviewed' = CALCULATE([Candidate Labels], KEEPFILTERS(Labels[Review status] = "Not reviewed"))
		formatString: 0
		lineageTag: dc8f6f98-3ffe-4752-ba9e-fa5df921517e

	measure 'Reviewed Unresolved' = [Reviewed Labels] - [Classified Labels]
		formatString: 0
		lineageTag: b14e8ca7-1f0d-40d3-a8c0-1a089b722b67

	measure 'Review Coverage %' = DIVIDE([Reviewed Labels], [Candidate Labels])
