table Labels

	measure 'Candidate Labels' = COUNTROWS(Labels)
		formatString: 0

	measure 'Reviewed Labels' = COALESCE(CALCULATE(COUNTROWS(Labels), KEEPFILTERS(Labels[Review] = "Reviewed")), 0)
		formatString: 0

	measure 'Usable Labels' = COALESCE(CALCULATE(COUNTROWS(Labels), KEEPFILTERS(Labels[Usable] = 1)), 0)
		formatString: 0

	measure 'Follow Up Labels' = COALESCE(CALCULATE(COUNTROWS(Labels), KEEPFILTERS(Labels[Priority] <> "P3")), 0)
		formatString: 0

	measure 'Review Coverage %' = DIVIDE([Reviewed Labels], [Candidate Labels])
		formatString: 0.0%

	measure 'Usable Coverage %' = DIVIDE([Usable Labels], [Candidate Labels])
		formatString: 0.0%

	measure 'Occurrence Rows' = COUNTROWS(Occurrences)
		formatString: 0

	measure 'Claim Rows' = COUNTROWS(Evidence)
		formatString: 0

	column 'LabelID'
		dataType: string
		summarizeBy: none
		sourceColumn: LabelID

	column 'Supplier label'
		dataType: string
		summarizeBy: none
		sourceColumn: Supplier label

	column 'Technology'
		dataType: string
		summarizeBy: none
		sourceColumn: Technology

	column 'Review'
		dataType: string
		summarizeBy: none
		sourceColumn: Review

	column 'Identity'
		dataType: string
		summarizeBy: none
		sourceColumn: Identity

	column 'Usable'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Usable

	column 'Priority'
		dataType: string
		summarizeBy: none
		sourceColumn: Priority

	column 'Reason'
		dataType: string
		summarizeBy: none
		sourceColumn: Reason

	column 'Next action'
		dataType: string
		summarizeBy: none
		sourceColumn: Next action

	column 'As of'
		dataType: string
		summarizeBy: none
		sourceColumn: As of

	partition 'Labels' = m
		mode: import
		source =
			let
				Rows = #table({"LabelID", "Supplier label", "Technology", "Review", "Identity", "Usable", "Priority", "Reason", "Next action", "As of"}, {
				{"FA", "Workshop A", "Machining", "Reviewed", "Resolved", 1, "P3", "Usable example", "Retain evidence and schedule a later review", "2025-12-01"},
				{"FB", "Workshop B", "Machining", "Reviewed", "Resolved", 0, "P1", "Scope mismatch", "Request the site-level scope and denominator", "2025-12-01"},
				{"FC", "Workshop C", "Automation", "Reviewed", "Unresolved", 0, "P1", "Identity unresolved", "Confirm the legal entity before attribution", "2025-12-01"},
				{"FD", "Workshop D", "Automation", "Reviewed", "Resolved", 0, "P2", "Historical period", "Request a current-period disclosure", "2025-12-01"},
				{"FE", "Workshop E", "Finishing", "Reviewed", "Resolved", 0, "P2", "Missing unit", "Confirm the metric unit before interpretation", "2025-12-01"},
				{"FF", "Workshop F", "Finishing", "Not reviewed", "Resolved", 0, "P2", "No evidence", "Request a source and reporting period", "2025-12-01"},
				{"FG", "Workshop G", "Forming", "Reviewed", "Resolved", 1, "P3", "Usable example", "Retain evidence and schedule a later review", "2025-12-01"},
				{"FH", "Workshop H", "Forming", "Not reviewed", "Resolved", 0, "P2", "Unreviewed", "Review the example source and scope", "2025-12-01"}
				}),
				Typed = Table.TransformColumnTypes(Rows, {{"LabelID", type text}, {"Supplier label", type text}, {"Technology", type text}, {"Review", type text}, {"Identity", type text}, {"Usable", type number}, {"Priority", type text}, {"Reason", type text}, {"Next action", type text}, {"As of", type text}})
			in Typed

	annotation PBI_ResultType = Table
