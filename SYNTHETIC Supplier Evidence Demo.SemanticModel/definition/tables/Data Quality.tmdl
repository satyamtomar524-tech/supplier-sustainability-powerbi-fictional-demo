table 'Data Quality'

	column 'Check'
		dataType: string
		summarizeBy: none
		sourceColumn: Check

	column 'Value'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Value

	partition 'Data Quality' = m
		mode: import
		source =
			let
				Rows = #table({"Check", "Value"}, {
				{"Raw supplier cells", 11},
				{"Excluded placeholders", 1},
				{"Retained occurrences", 10},
				{"Candidate labels", 8},
				{"Raw evidence rows", 9},
				{"Exact duplicate removed", 1},
				{"Retained claims", 8}
				}),
				Typed = Table.TransformColumnTypes(Rows, {{"Check", type text}, {"Value", type number}})
			in Typed

	annotation PBI_ResultType = Table
