table Occurrences

	column 'LabelID'
		dataType: string
		summarizeBy: none
		sourceColumn: LabelID

	column 'Source row'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Source row

	column 'Supplier label'
		dataType: string
		summarizeBy: none
		sourceColumn: Supplier label

	column 'Technology'
		dataType: string
		summarizeBy: none
		sourceColumn: Technology

	partition 'Occurrences' = m
		mode: import
		source =
			let
				Rows = #table({"LabelID", "Source row", "Supplier label", "Technology"}, {
				{"FA", 2, "Fictional Workshop A", "Machining"},
				{"FB", 3, "Fictional Workshop B", "Machining"},
				{"FC", 4, "Fictional Workshop C", "Automation"},
				{"FD", 5, "Fictional Workshop D", "Automation"},
				{"FE", 6, "Fictional Workshop E", "Finishing"},
				{"FF", 7, "Fictional Workshop F", "Finishing"},
				{"FG", 8, "Fictional Workshop G", "Forming"},
				{"FH", 9, "Fictional Workshop H", "Forming"},
				{"FA", 10, "Fictional Workshop A", "Machining"},
				{"FG", 11, "Fictional Workshop G", "Forming"}
				}),
				Typed = Table.TransformColumnTypes(Rows, {{"LabelID", type text}, {"Source row", type number}, {"Supplier label", type text}, {"Technology", type text}})
			in Typed

	annotation PBI_ResultType = Table
